      "title": "La salle de classe",
      "englishTitle": "The Classroom",
      "pages": "pp. 9–22",
      "description": "Master classroom objects, instructions, articles, possession with 'de', the essential verbs avoir & être, and prepositions of place.",
      "accentColor": "#1C88F5",
      "lessons": [
        {
          "id": "ch2-l1",
          "number": "2.1",
          "title": "Classroom Objects & People",
          "frenchTitle": "Les objets de la classe",
          "pages": "p. 9, 14, 18",
          "focus": "Words",
          "description": "Build typing muscle memory for everyday classroom nouns and masculine/feminine articles (le, la, l').",
          "items": [
            { "id": "c2_la_table", "en": "the table", "fr": "la table", "type": "word", "tag": "Feminine noun", "hint": "Use 'la' for feminine singular nouns." },
            { "id": "c2_la_trousse", "en": "the pencil case", "fr": "la trousse", "type": "word", "tag": "Feminine noun", "hint": "'la' shows that trousse is feminine." },
            { "id": "c2_la_gomme", "en": "the eraser", "fr": "la gomme", "type": "word", "tag": "Feminine noun", "hint": "Double 'm' in gomme." },
            { "id": "c2_la_regle", "en": "the ruler", "fr": "la règle", "type": "word", "tag": "Feminine noun", "hint": "Notice the grave accent on è in règle." },
            { "id": "c2_la_fenetre", "en": "the window", "fr": "la fenêtre", "type": "word", "tag": "Feminine noun", "hint": "Circumflex accent on ê in fenêtre." },
            { "id": "c2_la_lampe", "en": "the lamp", "fr": "la lampe", "type": "word", "tag": "Feminine noun", "hint": "Feminine noun — uses 'la'." },
            { "id": "c2_la_television", "en": "the television", "fr": "la télévision", "type": "word", "tag": "Feminine noun", "hint": "Two acute accents: é in télé-." },
            { "id": "c2_l_ordinateur", "en": "the computer", "fr": "l'ordinateur", "type": "word", "tag": "Masculine noun", "hint": "'le' becomes l' before a vowel." },
            { "id": "c2_le_sac", "en": "the bag", "fr": "le sac", "type": "word", "tag": "Masculine noun", "hint": "Masculine noun — uses 'le'." },
            { "id": "c2_le_stylo", "en": "the pen", "fr": "le stylo", "type": "word", "tag": "Masculine noun", "hint": "Masculine noun — uses 'le'." },
            { "id": "c2_le_crayon", "en": "the pencil", "fr": "le crayon", "type": "word", "tag": "Masculine noun", "hint": "Masculine noun — uses 'le'." },
            { "id": "c2_la_carte", "en": "the map", "fr": "la carte", "type": "word", "tag": "Feminine noun", "hint": "Feminine noun — uses 'la'." },
            { "id": "c2_le_tableau", "en": "the board", "fr": "le tableau", "type": "word", "tag": "Masculine noun", "hint": "'eau' sounds like a soft 'oh'." },
            { "id": "c2_le_cahier", "en": "the exercise book", "fr": "le cahier", "type": "word", "tag": "Masculine noun", "hint": "The 'h' in cahier is silent." },
            { "id": "c2_le_livre", "en": "the book", "fr": "le livre", "type": "word", "tag": "Masculine noun", "hint": "Masculine noun — uses 'le'." },
            { "id": "c2_la_porte", "en": "the door", "fr": "la porte", "type": "word", "tag": "Feminine noun", "hint": "Feminine noun — uses 'la'." },
            { "id": "c2_le_pupitre", "en": "the desk", "fr": "le pupitre", "type": "word", "tag": "Masculine noun", "hint": "Masculine noun — uses 'le'." },
            { "id": "c2_la_fille", "en": "the girl", "fr": "la fille", "type": "word", "tag": "Feminine noun", "hint": "Double 'l' sounds like 'y' in fille." },
            { "id": "c2_le_garcon", "en": "the boy", "fr": "le garçon", "type": "word", "tag": "Masculine noun", "hint": "Cedilla ç gives a soft 's' sound before 'o'." },
            { "id": "c2_le_professeur", "en": "the teacher (male)", "fr": "le professeur", "type": "word", "tag": "Masculine noun", "hint": "Shortened informally to 'le prof'." },
            { "id": "c2_la_chaise", "en": "the chair", "fr": "la chaise", "type": "word", "tag": "Feminine noun", "hint": "Introduced on p. 14." },
            { "id": "c2_la_calculatrice", "en": "the calculator", "fr": "la calculatrice", "type": "word", "tag": "Feminine noun", "hint": "Also called 'la calculette' (p. 14)." }
          ]
        },
        {
          "id": "ch2-l2",
          "number": "2.2",
          "title": "Classroom Instructions & Questions",
          "frenchTitle": "Les consignes en classe",
          "pages": "pp. 10–11",
          "focus": "Sentences",
          "description": "Type real sentences a French teacher uses in class — commands, dates, and asking what things are.",
          "items": [
            { "id": "c2_quest_ce_que_cest", "en": "What is this? / What is it?", "fr": "Qu'est-ce que c'est?", "type": "sentence", "tag": "Key question", "hint": "Literally 'What is it that it is?' (p. 10)." },
            { "id": "c2_cest_une_salle", "en": "It's a classroom.", "fr": "C'est une salle de classe.", "type": "sentence", "tag": "Statement", "hint": "Answers to 'Qu'est-ce que c'est?' usually start with C'est." },
            { "id": "c2_asseyez_vous", "en": "Sit down!", "fr": "Asseyez-vous!", "type": "sentence", "tag": "Instruction (pl.)", "hint": "Plural/polite command to the whole class." },
            { "id": "c2_levez_vous", "en": "Stand up!", "fr": "Levez-vous!", "type": "sentence", "tag": "Instruction (pl.)", "hint": "Hyphen links verb and 'vous'." },
            { "id": "c2_allez_au_travail", "en": "Right, to work!", "fr": "Allez, au travail!", "type": "sentence", "tag": "Instruction (pl.)", "hint": "Classroom rallying phrase (p. 10)." },
            { "id": "c2_ouvrez_vos_livres", "en": "Open your books!", "fr": "Ouvrez vos livres!", "type": "sentence", "tag": "Instruction (pl.)", "hint": "'vos' = your (plural)." },
            { "id": "c2_ouvrez_la_fenetre", "en": "Open the window!", "fr": "Ouvrez la fenêtre!", "type": "sentence", "tag": "Instruction (pl.)", "hint": "Circumflex accent on ê in fenêtre." },
            { "id": "c2_fermez_la_fenetre", "en": "Close the window!", "fr": "Fermez la fenêtre!", "type": "sentence", "tag": "Instruction (pl.)", "hint": "Plural command ends in -ez." },
            { "id": "c2_ecoutez", "en": "Listen!", "fr": "Écoutez!", "type": "sentence", "tag": "Instruction (pl.)", "hint": "Starts with capital É (acute accent)." },
            { "id": "c2_ecrivez", "en": "Write!", "fr": "Écrivez!", "type": "sentence", "tag": "Instruction (pl.)", "hint": "Starts with capital É." },
            { "id": "c2_copiez", "en": "Copy!", "fr": "Copiez!", "type": "sentence", "tag": "Instruction (pl.)", "hint": "Ends in -ez for the whole class." },
            { "id": "c2_parlez", "en": "Speak!", "fr": "Parlez!", "type": "sentence", "tag": "Instruction (pl.)", "hint": "Ends in -ez for the whole class." },
            { "id": "c2_mettez_vous_a_deux", "en": "Get into pairs!", "fr": "Mettez-vous à deux!", "type": "sentence", "tag": "Instruction (pl.)", "hint": "'à' has a grave accent." },
            { "id": "c2_ferme_la_porte", "en": "Georges, close the door, please!", "fr": "Georges, ferme la porte, s'il te plaît!", "type": "sentence", "tag": "Instruction (sing.)", "hint": "Singular informal uses 'ferme' and 's'il te plaît'." },
            { "id": "c2_on_est_quel_jour", "en": "What day is it?", "fr": "On est quel jour?", "type": "sentence", "tag": "Question", "hint": "Everyday French way to ask the day (p. 11)." },
            { "id": "c2_on_est_jeudi", "en": "It is Thursday.", "fr": "On est jeudi.", "type": "sentence", "tag": "Answer", "hint": "Days of the week aren't capitalized in French." },
            { "id": "c2_ou_est_ton_cahier", "en": "Where is your exercise book?", "fr": "Où est ton cahier?", "type": "sentence", "tag": "Question", "hint": "'où' (with accent) means 'where'." },
            { "id": "c2_il_est_dans_mon_sac", "en": "It is in my bag.", "fr": "Il est dans mon sac.", "type": "sentence", "tag": "Answer", "hint": "Use 'il' for 'it' when referring to a masculine noun (cahier)." }
          ]
        },
        {
          "id": "ch2-l3",
          "number": "2.3",
          "title": "Articles, Possessives & 'De'",
          "frenchTitle": "Mon, ma, mes & la possession",
          "pages": "pp. 12–15",
          "focus": "Phrases",
          "description": "Practice 'the', 'a/some', 'my', 'your' across genders and plurals, plus showing possession with de, d', du, de la, des.",
          "items": [
            { "id": "c2_mon_livre", "en": "my book", "fr": "mon livre", "type": "phrase", "tag": "Possessive (m.)", "hint": "'mon' goes with masculine singular nouns." },
            { "id": "c2_ma_trousse", "en": "my pencil case", "fr": "ma trousse", "type": "phrase", "tag": "Possessive (f.)", "hint": "'ma' goes with feminine singular nouns." },
            { "id": "c2_mes_crayons", "en": "my pencils", "fr": "mes crayons", "type": "phrase", "tag": "Possessive (pl.)", "hint": "'mes' works for all plural nouns." },
            { "id": "c2_ton_crayon", "en": "your pencil", "fr": "ton crayon", "type": "phrase", "tag": "Possessive (m.)", "hint": "'ton' goes with masculine singular nouns." },
            { "id": "c2_ta_regle", "en": "your ruler", "fr": "ta règle", "type": "phrase", "tag": "Possessive (f.)", "hint": "'ta' goes with feminine singular nouns." },
            { "id": "c2_tes_cartes", "en": "your maps", "fr": "tes cartes", "type": "phrase", "tag": "Possessive (pl.)", "hint": "'tes' is used for all plural nouns." },
            { "id": "c2_mon_amie", "en": "my friend (female)", "fr": "mon amie", "type": "phrase", "tag": "Vowel rule", "hint": "Use 'mon/ton' even for feminine nouns starting with a vowel (p. 13)." },
            { "id": "c2_l_ecole", "en": "the school", "fr": "l'école", "type": "word", "tag": "Vowel rule", "hint": "'la' becomes l' before a vowel." },
            { "id": "c2_des_filles", "en": "some girls", "fr": "des filles", "type": "phrase", "tag": "Plural article", "hint": "The plural of 'un/une' is 'des' (some)." },
            { "id": "c2_des_garcons", "en": "some boys", "fr": "des garçons", "type": "phrase", "tag": "Plural article", "hint": "Don't forget the cedilla in garçons." },
            { "id": "c2_il_y_a", "en": "there is / there are", "fr": "il y a", "type": "phrase", "tag": "Key expression", "hint": "Essential phrase used throughout Chapter 2 (p. 12)." },
            { "id": "c2_beaucoup_de", "en": "lots of", "fr": "beaucoup de", "type": "phrase", "tag": "Key expression", "hint": "Introduced in Exercice 2.2 (p. 12)." },
            { "id": "c2_la_trousse_de_sophie", "en": "Sophie's pencil case", "fr": "la trousse de Sophie", "type": "phrase", "tag": "Possession (de)", "hint": "Literally 'the pencil case of Sophie' — no apostrophe-s in French!" },
            { "id": "c2_la_trousse_d_amelie", "en": "Amélie's pencil case", "fr": "la trousse d'Amélie", "type": "phrase", "tag": "Possession (d')", "hint": "'de' shortens to d' before a vowel." },
            { "id": "c2_la_trousse_du_garcon", "en": "the boy's pencil case", "fr": "la trousse du garçon", "type": "phrase", "tag": "Possession (du)", "hint": "'de + le' always merges into 'du'." },
            { "id": "c2_la_classe_des_eleves", "en": "the pupils' classroom", "fr": "la classe des élèves", "type": "phrase", "tag": "Possession (des)", "hint": "'de + les' merges into 'des'." },
            { "id": "c2_l_ordinateur_du_prof", "en": "the teacher's computer", "fr": "l'ordinateur du professeur", "type": "phrase", "tag": "Possession (du)", "hint": "Exercice 2.8 (p. 15): 'du' = of the (masculine)." },
            { "id": "c2_voici_mon_stylo", "en": "Here is my pen!", "fr": "Voici mon stylo!", "type": "sentence", "tag": "Expression", "hint": "Exercice 2.7 (p. 14): 'Voici' = here is." }
          ]
        },
        {
          "id": "ch2-l4",
          "number": "2.4",
          "title": "Verb Avoir (To Have) & Age",
          "frenchTitle": "Le verbe avoir et l'âge",
          "pages": "pp. 16–17, 21–22",
          "focus": "Sentences",
          "description": "Type every form of avoir (j'ai, tu as, il/elle a, nous avons, vous avez, ils/elles ont) and talk about age.",
          "items": [
            { "id": "c2_jai_un_cahier", "en": "I have an exercise book.", "fr": "J'ai un cahier.", "type": "sentence", "tag": "avoir (je)", "hint": "'je' becomes j' before a vowel." },
            { "id": "c2_tu_as_un_livre", "en": "You (sing.) have a book.", "fr": "Tu as un livre.", "type": "sentence", "tag": "avoir (tu)", "hint": "Exercice 2.10 (p. 17)." },
            { "id": "c2_il_a_des_crayons", "en": "He has some pencils.", "fr": "Il a des crayons.", "type": "sentence", "tag": "avoir (il)", "hint": "Third-person singular of avoir is 'a' (no accent!)." },
            { "id": "c2_elle_a_une_gomme", "en": "She has an eraser.", "fr": "Elle a une gomme.", "type": "sentence", "tag": "avoir (elle)", "hint": "Exercice 2.9 (p. 16)." },
            { "id": "c2_nous_avons_des_crayons", "en": "We have some pencils.", "fr": "Nous avons des crayons.", "type": "sentence", "tag": "avoir (nous)", "hint": "'nous avons' = we have." },
            { "id": "c2_vous_avez_une_regle", "en": "Do you (pl.) have a ruler?", "fr": "Vous avez une règle?", "type": "sentence", "tag": "avoir (vous)", "hint": "'vous avez' = you (plural/polite) have." },
            { "id": "c2_ils_ont_un_ordinateur", "en": "They (m.) have a computer in the classroom.", "fr": "Ils ont un ordinateur dans la classe.", "type": "sentence", "tag": "avoir (ils)", "hint": "'ils ont' = they (m.) have." },
            { "id": "c2_elles_ont_les_trousses", "en": "They (f.) have the pencil cases.", "fr": "Elles ont les trousses.", "type": "sentence", "tag": "avoir (elles)", "hint": "Exercice 2.10 (p. 17)." },
            { "id": "c2_marc_a_les_stylos", "en": "Marc has Jean's pens.", "fr": "Marc a les stylos de Jean.", "type": "sentence", "tag": "avoir + de", "hint": "Names take the same verb form as il/elle: 'a'." },
            { "id": "c2_mon_ami_a_une_gomme", "en": "My friend has an eraser.", "fr": "Mon ami a une gomme.", "type": "sentence", "tag": "avoir (il)", "hint": "Exercice 2.10 (p. 17)." },
            { "id": "c2_quel_age_as_tu", "en": "How old are you?", "fr": "Quel âge as-tu?", "type": "sentence", "tag": "Age (avoir)", "hint": "Literally 'What age have you?' — circumflex on â in âge (p. 21)." },
            { "id": "c2_jai_onze_ans", "en": "I am eleven years old.", "fr": "J'ai onze ans.", "type": "sentence", "tag": "Age (avoir)", "hint": "French uses avoir ('I have eleven years'), not être." },
            { "id": "c2_il_a_un_an", "en": "He is one year old.", "fr": "Il a un an.", "type": "sentence", "tag": "Age (avoir)", "hint": "Singular 'an' (year) for age 1 (p. 21)." },
            { "id": "c2_nous_avons_douze_ans", "en": "We are twelve years old.", "fr": "Nous avons douze ans.", "type": "sentence", "tag": "Age (avoir)", "hint": "Exercice 2.17 (p. 22)." },
            { "id": "c2_quest_ce_que_tu_as", "en": "What do you have in your pencil case?", "fr": "Qu'est-ce que tu as dans ta trousse?", "type": "sentence", "tag": "Dialogue", "hint": "From Marc's dialogue in Exercice 2.13 (p. 19)." },
            { "id": "c2_dans_ma_salle_de_classe", "en": "In my classroom, there is a pen and some pencils.", "fr": "Dans ma salle de classe, il y a un stylo et des crayons.", "type": "sentence", "tag": "Memory game", "hint": "From 'Dans ma salle de classe' (p. 22)." }
          ]
        },
        {
          "id": "ch2-l5",
          "number": "2.5",
          "title": "Verb Être (To Be) & Where Things Are",
          "frenchTitle": "Le verbe être et les prépositions",
          "pages": "pp. 17–20",
          "focus": "Sentences",
          "description": "Master all forms of être (je suis, tu es, il/elle est, nous sommes, vous êtes, ils/elles sont) and say where objects are located.",
          "items": [
            { "id": "c2_bonjour_je_suis_nicolas", "en": "Hello, sir, I am Nicolas.", "fr": "Bonjour, monsieur, je suis Nicolas.", "type": "sentence", "tag": "être (je)", "hint": "From 'La rentrée' conversation (p. 17)." },
            { "id": "c2_tu_es_dans_ma_classe", "en": "Are you in my class?", "fr": "Tu es dans ma classe?", "type": "sentence", "tag": "être (tu)", "hint": "'tu es' = you (sing.) are." },
            { "id": "c2_il_est_dans_ma_classe", "en": "He is in my class.", "fr": "Il est dans ma classe.", "type": "sentence", "tag": "être (il)", "hint": "'il est' = he is / it is (m.)." },
            { "id": "c2_nous_sommes_dans_la_classe", "en": "We are also in the class.", "fr": "Nous sommes aussi dans la classe.", "type": "sentence", "tag": "être (nous)", "hint": "'nous sommes' = we are; 'aussi' = also (p. 18)." },
            { "id": "c2_vous_etes_dans_ma_classe", "en": "Are you (pl.) also in my class?", "fr": "Vous êtes aussi dans ma classe?", "type": "sentence", "tag": "être (vous)", "hint": "Circumflex accent on ê in êtes." },
            { "id": "c2_les_filles_sont_dans_la_classe", "en": "The girls are in the class.", "fr": "Les filles sont dans la classe.", "type": "sentence", "tag": "être (elles)", "hint": "Exercice 2.11 (p. 18)." },
            { "id": "c2_il_est_fou_le_prof", "en": "He is crazy, the teacher!", "fr": "Il est fou, le prof!", "type": "sentence", "tag": "Dialogue", "hint": "'fou' = mad, crazy (p. 18)." },
            { "id": "c2_devant", "en": "in front of", "fr": "devant", "type": "word", "tag": "Preposition", "hint": "Location vocabulary (p. 18)." },
            { "id": "c2_derriere", "en": "behind", "fr": "derrière", "type": "word", "tag": "Preposition", "hint": "Double 'r' and grave accent è." },
            { "id": "c2_a_cote_de", "en": "next to", "fr": "à côté de", "type": "phrase", "tag": "Preposition", "hint": "Three accents: à, ô, é (p. 18)." },
            { "id": "c2_entre", "en": "between", "fr": "entre", "type": "word", "tag": "Preposition", "hint": "Location vocabulary (p. 18)." },
            { "id": "c2_ou_est_la_trousse", "en": "Where is the pencil case?", "fr": "Où est la trousse?", "type": "sentence", "tag": "Question", "hint": "Exercice 2.12 (p. 19)." },
            { "id": "c2_elle_est_sur_le_pupitre", "en": "It is on the desk.", "fr": "Elle est sur le pupitre.", "type": "sentence", "tag": "Location", "hint": "Use 'elle' because 'la trousse' is feminine." },
            { "id": "c2_il_est_sous_la_table", "en": "It is under the table.", "fr": "Il est sous la table.", "type": "sentence", "tag": "Location", "hint": "Use 'il' for 'le sac'; 'sous' = under." },
            { "id": "c2_le_stylo_de_pierre_est_rouge", "en": "Pierre's pen is red.", "fr": "Le stylo de Pierre est rouge.", "type": "sentence", "tag": "Dialogue", "hint": "Exercice 2.13 (p. 19–20)." },
            { "id": "c2_le_dictionnaire", "en": "the dictionary", "fr": "le dictionnaire", "type": "word", "tag": "Masculine noun", "hint": "Double 'n' in dictionnaire (p. 18)." },
            { "id": "c2_la_poubelle", "en": "the bin", "fr": "la poubelle", "type": "word", "tag": "Feminine noun", "hint": "Introduced on p. 18." },
            { "id": "c2_la_regle_de_sophie", "en": "Sophie's ruler is in Anne-Marie's pencil case.", "fr": "La règle de Sophie est dans la trousse d'Anne-Marie.", "type": "sentence", "tag": "Challenge sentence", "hint": "Exercice 2.14 (p. 20) — combines être, dans, and d'." }
          ]
        },
        {
