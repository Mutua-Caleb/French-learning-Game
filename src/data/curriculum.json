  "grammarGuides": [
    {
      "id": "articles",
      "title": "The, A/Some, My, Your, His/Her",
      "pages": "pp. 12–13, 29",
      "summary": "Articles and possessives agree with the gender and number of the noun they describe. Before a vowel or silent 'h', le/la become l', and ma/ta/sa become mon/ton/son.",
      "headers": ["Meaning", "Masculine", "Feminine", "Plural"],
      "rows": [
        ["the", "le (l')", "la (l')", "les"],
        ["a / some", "un", "une", "des"],
        ["my", "mon", "ma", "mes"],
        ["your (sing.)", "ton", "ta", "tes"],
        ["his / her / its", "son", "sa", "ses"]
      ]
    },
    {
      "id": "possession",
      "title": "Showing Possession with 'de'",
      "pages": "pp. 14–15",
      "summary": "French never uses 's. Instead, flip the phrase to 'the X of Y': Sophie's pencil case → la trousse de Sophie.",
      "headers": ["Rule", "Form", "Example", "English"],
      "rows": [
        ["Before a name", "de", "le livre de Sophie", "Sophie's book"],
        ["Before a vowel", "d'", "la trousse d'Amélie", "Amélie's pencil case"],
        ["de + le (m.)", "du", "la trousse du garçon", "the boy's pencil case"],
        ["de + la (f.)", "de la", "le sac de la fille", "the girl's bag"],
        ["de + l'", "de l'", "la classe de l'élève", "the pupil's classroom"],
        ["de + les (pl.)", "des", "la classe des élèves", "the pupils' classroom"]
      ]
    },
    {
      "id": "avoir-etre",
      "title": "Essential Verbs: Avoir & Être",
      "pages": "pp. 16–17",
      "summary": "Avoir (to have) is also used for age (J'ai onze ans). Être (to be) describes who, what, or where people and things are.",
      "headers": ["Pronoun", "Avoir (to have)", "Être (to be)", "English"],
      "rows": [
        ["je / j'", "j'ai", "je suis", "I have / I am"],
        ["tu", "tu as", "tu es", "you (sing.) have / are"],
        ["il / elle", "il/elle a", "il/elle est", "he/she has / is"],
        ["nous", "nous avons", "nous sommes", "we have / are"],
        ["vous", "vous avez", "vous êtes", "you (pl.) have / are"],
        ["ils / elles", "ils/elles ont", "ils/elles sont", "they have / are"]
      ]
    },
    {
      "id": "er-verbs",
      "title": "First-Group (-ER) Verbs",
      "pages": "pp. 24–28",
      "summary": "Remove -er from the infinitive (e.g. regarder → regard-) and add the ending. One French form translates both 'I watch' and 'I am watching'.",
      "headers": ["Pronoun", "Ending", "regarder", "English"],
      "rows": [
        ["je", "-e", "je regarde", "I watch / am watching"],
        ["tu", "-es", "tu regardes", "you watch / are watching"],
        ["il / elle", "-e", "il/elle regarde", "he/she watches / is watching"],
        ["nous", "-ons", "nous regardons", "we watch / are watching"],
        ["vous", "-ez", "vous regardez", "you (pl.) watch / are watching"],
        ["ils / elles", "-ent (silent)", "ils/elles regardent", "they watch / are watching"]
      ]
    }
  ]
