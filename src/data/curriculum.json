            { "id": "c2_une_etagere", "en": "a shelf", "fr": "une étagère", "type": "word", "tag": "Feminine noun", "hint": "Acute é then grave è (p. 14)." },
            { "id": "c2_le_placard", "en": "the cupboard", "fr": "le placard", "type": "word", "tag": "Masculine noun", "hint": "Classroom object (p. 18)." },
            { "id": "c2_le_ballon", "en": "the ball", "fr": "le ballon", "type": "word", "tag": "Masculine noun", "hint": "Double 'l' (p. 18)." },
            { "id": "c2_jai_cinq_crayons", "en": "I have five pencils and two pens.", "fr": "J'ai cinq crayons et deux stylos.", "type": "sentence", "tag": "Dialogue", "hint": "From Exercice 2.13 (p. 19)." },
