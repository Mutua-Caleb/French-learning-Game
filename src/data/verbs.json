      "en": "to be",
      "group": "irregular",
      "aux": "avoir",
      "tip": "One of the two essential irregular French verbs (with avoir). Also serves as the auxiliary verb in compound past tenses for movement verbs like aller and venir.",
      "example": {
        "id": "v_ex_etre",
        "fr": "Ils sont devant le musée.",
        "en": "They are in front of the museum.",
        "tense": "Présent"
      },
      "conjugations": {
        "present": ["Je suis", "Tu es", "Il est", "Nous sommes", "Vous êtes", "Ils sont"],
        "passe_compose": ["J'ai été", "Tu as été", "Il a été", "Nous avons été", "Vous avez été", "Ils ont été"],
        "imparfait": ["J'étais", "Tu étais", "Il était", "Nous étions", "Vous étiez", "Ils étaient"],
        "futur": ["Je serai", "Tu seras", "Il sera", "Nous serons", "Vous serez", "Ils seront"]
      },
      "enForms": {
        "present": ["I am", "you (sing.) are", "he is", "we are", "you (pl.) are", "they are"],
        "passe_compose_je": "I was / I have been",
        "imparfait_je": "I was / I used to be",
        "futur_je": "I will be"
