        { "id": "v_ex_aider", "en": "She will help them move apartments.", "fr": "Elle les aidera à déménager.", "type": "sentence", "tag": "aider · Futur", "hint": "'aider à' + infinitive." },
        { "id": "v_ex_aimer", "en": "They used to love playing together when they were children.", "fr": "Ils aimaient jouer ensemble quand ils étaient enfants.", "type": "sentence", "tag": "aimer · Imparfait", "hint": "Preply example combining aimer and être in imparfait." },
        { "id": "v_ex_regarder", "en": "I watched the birds in the forest.", "fr": "J'ai regardé les oiseaux dans la forêt.", "type": "sentence", "tag": "regarder · Passé composé", "hint": "'Regarder' = intentionally watch (vs passive 'voir')." },
