        { "id": "v_ex_je_ne_peux_pas", "en": "I'm really sorry, but I can't help you.", "fr": "Je suis vraiment désolé, mais je ne peux pas vous aider.", "type": "sentence", "tag": "être + pouvoir + aider", "hint": "Combines three top-20 verbs!" },
        { "id": "v_ex_je_dois_dire", "en": "I have to tell him this. I can't lie!", "fr": "Je dois lui dire ça. Je ne peux pas mentir!", "type": "sentence", "tag": "devoir + dire + pouvoir", "hint": "Preply example for devoir." },
        { "id": "v_ex_dire", "en": "He told everyone the truth.", "fr": "Il a dit la vérité à tout le monde.", "type": "sentence", "tag": "dire · Passé composé", "hint": "'tout le monde' = everyone." },
